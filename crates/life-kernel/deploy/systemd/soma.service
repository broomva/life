[Unit]
Description=Life Agent OS kernel daemon (soma)
Documentation=https://github.com/broomva/life/tree/main/crates/life-kernel/deploy/systemd/README.md
After=network.target
Wants=network.target

[Service]
# Type=simple: systemd marks soma as "active" as soon as the process forks.
# Readiness check is "can connect to /run/life/soma.sock".
#
# NOTE: Type=notify (proper sd_notify(STATE_READY) integration) is deferred.
# See deploy/systemd/README.md for details.
Type=simple
ExecStart=/usr/local/bin/soma daemon
Restart=on-failure
RestartSec=5s

# ── Environment ─────────────────────────────────────────────────────────────
# Override per deployment. The daemon also reads SOMA_CONFIG at startup.
Environment=SOMA_CONFIG=/etc/soma/config.toml
Environment=RUST_LOG=info

# ── Security hardening ───────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# ── Runtime / state / log directories (auto-created by systemd) ─────────────
# /run/life/         — Unix socket and PID file (shared with the future Life
#                       Runtime daemons: lifed (facade), lifegw (edge gateway))
# /var/lib/soma/     — redb journal (durable Lago store)
# /var/log/soma/     — structured log files (journald is the primary sink)
RuntimeDirectory=life
RuntimeDirectoryMode=0750
StateDirectory=soma
StateDirectoryMode=0750
LogsDirectory=soma
LogsDirectoryMode=0750

# ── Capabilities ─────────────────────────────────────────────────────────────
# Minimum for the default local (Docker / nsjail) backend profile.
# See README.md for the capability table for other backend profiles.
#
# local (Docker/nsjail):   CAP_SYS_ADMIN + CAP_NET_ADMIN
# cube  (Phase 3, BPF):    add CAP_BPF + CAP_NET_ADMIN
# vercel (Phase 4, HTTP):  no extra caps; remove both lines below
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN

# ── File descriptor limits ───────────────────────────────────────────────────
# Needed when managing many concurrent Docker/nsjail containers.
LimitNOFILE=65536

# ── Restart limits ───────────────────────────────────────────────────────────
# Allow up to 5 quick restarts within 60 s (tolerates new redb files /
# config changes). After exhaustion systemd enters failed state.
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
