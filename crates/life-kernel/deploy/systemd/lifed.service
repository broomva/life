[Unit]
Description=Life Agent OS kernel daemon (lifed)
Documentation=https://github.com/broomva/life/tree/main/crates/life-kernel/deploy/systemd/README.md
After=network.target
Wants=network.target

[Service]
# Type=simple: systemd marks lifed as "active" as soon as the process forks.
# Readiness check is "can connect to /run/lifed/sock".
#
# NOTE: Type=notify (proper sd_notify(STATE_READY) integration) is deferred
# to BRO-903 / post-Phase-2.  See deploy/systemd/README.md for details.
Type=simple
ExecStart=/usr/local/bin/lifed
Restart=on-failure
RestartSec=5s

# ── Environment ─────────────────────────────────────────────────────────────
# Override per deployment.  The daemon also reads LIFED_CONFIG at startup.
Environment=LIFED_CONFIG=/etc/lifed/config.toml
Environment=RUST_LOG=info

# ── Security hardening ───────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# ── Runtime / state / log directories (auto-created by systemd) ─────────────
# /run/lifed/      — Unix socket and PID file
# /var/lib/lifed/  — redb journal (durable Lago store)
# /var/log/lifed/  — structured log files (journald is the primary sink)
RuntimeDirectory=lifed
RuntimeDirectoryMode=0750
StateDirectory=lifed
StateDirectoryMode=0750
LogsDirectory=lifed
LogsDirectoryMode=0750

# ── Capabilities ─────────────────────────────────────────────────────────────
# Minimum for the default local (Docker / nsjail) backend profile.
# See README.md for the capability table for other backend profiles.
#
# local (Docker/nsjail):   CAP_SYS_ADMIN + CAP_NET_ADMIN
# cube  (Phase 3, BPF):    add CAP_BPF + CAP_NET_ADMIN
# vercel (Phase 4, HTTP):  no extra caps; remove both lines below
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN

# ── File descriptor limits ───────────────────────────────────────────────────
# Needed when managing many concurrent Docker/nsjail containers.
LimitNOFILE=65536

# ── Restart limits ───────────────────────────────────────────────────────────
# Allow up to 5 quick restarts within 60 s (tolerates new redb files /
# config changes).  After exhaustion systemd enters failed state.
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
