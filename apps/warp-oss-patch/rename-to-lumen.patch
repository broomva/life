 // Simple wrapper around warp::run() for Warp OSS builds.
+//
+// Lumen Phase α (broomva): the AppId is renamed from
+// ("dev", "warp", "WarpOss") to ("dev", "broomva", "Lumen") so the OSS
+// build's `project_path()` becomes `dev.broomva.Lumen`. This is what
+// determines the Application Support subdir under the team-level Group
+// Container (`~/Library/Group Containers/2BBY89MBSN.dev.warp/Library/
+// Application Support/{project_path}/`). Renaming guarantees the OSS
+// build's SQLite, keychain entries, and secure-storage live in a
+// completely separate subdir from the stable / preview / dev Warp
+// builds — so running Lumen alongside Warp.app no longer deadlocks
+// on shared DB / Keychain locks.
 fn main() -> Result<()> {
     let mut state = ChannelState::new(
         Channel::Oss,
         ChannelConfig {
-            app_id: AppId::new("dev", "warp", "WarpOss"),
-            logfile_name: "warp-oss.log".into(),
+            app_id: AppId::new("dev", "broomva", "Lumen"),
+            logfile_name: "lumen.log".into(),
             server_config: WarpServerConfig::production(),
             oz_config: OzConfig::production(),
             telemetry_config: None,
@@ -41,15 +52,15 @@ embed_plist::embed_info_plist_bytes!(r#"
